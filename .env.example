# Great Glizzy Gauntlet - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Admin password hash (SHA-256)
# Generate with:
#   async function hash(p) { const d = new TextEncoder().encode(p); const h = await crypto.subtle.digest('SHA-256', d); return [...new Uint8Array(h)].map(b => b.toString(16).padStart(2, '0')).join(''); }
#   await hash('your-password-here');
ADMIN_PASSWORD_HASH=your_sha256_hash_here

# Admin API token (must match Google Apps Script ADMIN_TOKEN property)
# Generate with: crypto.randomUUID()
ADMIN_TOKEN=your_uuid_token_here
